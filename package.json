{
  "name": "amazon-storefront",
  "version": "1.0.0",
  "description": "Amazon-inspired e-commerce app with Express backend and MySQL database",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:init": "mysql -u${DB_USER:-root} -p${DB_PASSWORD:-} ${DB_NAME:-amazon_store} < db/schema.sql && mysql -u${DB_USER:-root} -p${DB_PASSWORD:-} ${DB_NAME:-amazon_store} < db/seed.sql"
  },
  "keywords": [
    "ecommerce",
    "mysql",
    "express",
    "nodejs",
    "amazon-clone"
  ],
  "author": "codexvisual",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
